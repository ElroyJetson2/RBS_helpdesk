{
  "name": "rbs-helpdesk",
  "version": "1.0.0",
  "description": "RBS Helpdesk – incident reporting & tracking for Require Building Solutions",
  "private": true,
  "scripts": {
    "dev": "wrangler pages dev public --d1=DB=rbs-help-db --local",
    "deploy": "wrangler pages deploy public",
    "db:init": "wrangler d1 execute rbs-help-db --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute rbs-help-db --local --file=./schema.sql",
    "db:query": "wrangler d1 execute rbs-help-db --remote --command"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
